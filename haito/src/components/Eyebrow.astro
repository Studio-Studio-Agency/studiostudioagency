---
/**
 * Eyebrow. Kennzeichnet die Sektion inhaltlich, nicht dekorativ.
 * Zulaessig: «Leistung 01 / 03». Nicht zulaessig: «Featured», «Discover».
 */
interface Props {
  /** Beibehalten fuer Aufrufer; auf dem dunklen Grund ohne Wirkung. */
  dark?: boolean;
  as?: 'p' | 'span' | 'div';
  class?: string;
}
const { dark = false, as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['type-eyebrow', 'text-ink', className]}>
  <slot />
</Tag>
