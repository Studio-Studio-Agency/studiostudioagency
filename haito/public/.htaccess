# Serverkonfiguration fuer Apache. Wird von Astro nach dist/ kopiert und
# landet beim Upload im Web-Wurzelverzeichnis.
#
# Hinweis fuer nicht-Apache-Hoster (nginx, Caddy): diese Datei bleibt dort
# wirkungslos. Die Regeln muessen dann in die Serverkonfiguration uebertragen
# werden — inhaltlich sind es dieselben vier Bloecke.

# --- HTTPS erzwingen -------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Fehlerseite -----------------------------------------------------------
ErrorDocument 404 /404.html

# --- Kopfzeilen ------------------------------------------------------------
<IfModule mod_headers.c>
  # Erst setzen, wenn HTTPS sicher steht und laeuft. Ein zu frueh gesetzter
  # HSTS-Eintrag sperrt Besucher aus, wenn das Zertifikat Probleme macht —
  # der Browser merkt sich die Vorgabe ueber Monate.
  # Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Die Seite laedt nichts von fremden Domains. Diese Richtlinie schreibt das
  # fest: kaeme je ein Skript, eine Schrift oder ein Zaehlpixel von aussen
  # hinein, blockiert der Browser es, statt es stillschweigend zu laden.
  # Fuer einen Anbieter von Datensouveraenitaet ist das keine Zierde, sondern
  # das Versprechen in Serverform.
  #
  # 'unsafe-inline' bei style-src ist noetig: Astro schreibt Stile in die
  # Seite und es gibt 14 style-Attribute im Markup. script-src braucht es
  # nicht — die einzigen script-Elemente sind application/ld+json, und
  # solche Datenbloecke fuehrt der Browser nicht aus.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# --- Kompression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

# --- Zwischenspeicher ------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Dateien unter /_astro/ tragen einen Hash im Namen und aendern sich nie —
  # sie duerfen lange liegenbleiben.
  <FilesMatch "\.(css|js|woff2|avif|webp|png|jpg|svg)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>
  # HTML muss frisch bleiben, sonst sieht niemand die naechste Aenderung.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Verzeichnislisten unterbinden ----------------------------------------
Options -Indexes
