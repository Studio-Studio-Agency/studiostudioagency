# ---------------------------------------------------------------------------
# Frontend (Vite) — safe to expose, injected at build time
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-public-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# PostHog funnel tracking (optional — analytics are a no-op without the key)
VITE_POSTHOG_KEY="phc_..."
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# ---------------------------------------------------------------------------
# Edge function secrets — set with `supabase secrets set KEY=value`,
# NEVER commit real values. Used only by supabase/functions/klima-chat.
# ---------------------------------------------------------------------------
# Anthropic Claude API key (model: claude-sonnet-4-5)
ANTHROPIC_API_KEY="sk-ant-..."

# Where qualified leads are announced (both optional; enable what you use)
KLIMA_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"
RESEND_API_KEY="re_..."
KLIMA_LEAD_NOTIFY_EMAIL="leads@klimapartner-basel.ch"
KLIMA_LEAD_FROM_EMAIL="leads@klimapartner-basel.ch"

# Comma-separated login emails allowed to use the lead dashboard (/klimapartner/leads)
KLIMA_ADMIN_EMAILS="studio@alainsz.com"

# Server-side PostHog events (optional; same project key as the frontend)
POSTHOG_API_KEY="phc_..."
POSTHOG_HOST="https://eu.i.posthog.com"

# Provided automatically by the Supabase runtime — listed for reference:
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
