---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { withBase } from '../config/site';

/**
 * Platzhalter. Die Startseite wird in Schritt 2 vollstaendig nach
 * content-brief.md gebaut — die Datei liegt derzeit nicht im Projekt.
 */
---

<BaseLayout
  title="Vaulteer — Lokale KI-Systeme fuer Schweizer KMU"
  description="Vaulteer baut und betreibt lokale KI-Systeme fuer Schweizer KMU und beraet zu Datensouveraenitaet. Basel-Stadt."
  bareTitle
>
  <section class="container-grid section-md">
    <Eyebrow>Schritt 1 von 8 — Fundament</Eyebrow>
    <h1 class="type-display enter enter-1 mt-6">
      [TODO: Startseite folgt in<br />Schritt 2]
    </h1>
    <p class="type-lead measure-wide enter enter-2 mt-8 text-ink-muted">
      Das Fundament steht: Rahmen, Typoskala, Farbtokens, Kopf- und Fusszeile,
      Platzhaltersystem. Die Inhalte der Startseite stammen aus
      content-brief.md — diese Datei liegt noch nicht im Projekt.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href={withBase('/styleguide')} variant="primary">Musterseite ansehen</Button>
    </div>
  </section>
</BaseLayout>
