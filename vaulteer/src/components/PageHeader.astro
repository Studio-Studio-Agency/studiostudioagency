---
import Eyebrow from './Eyebrow.astro';

/**
 * Kopf einer Unterseite: Eyebrow, H1, Lead. Einheitlich, damit die Seiten
 * denselben Einstieg haben und die Ueberschriftenhierarchie stimmt.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="container-grid grid-12 pt-16 pb-14 md:pt-24 md:pb-20">
  <div class="col-span-full lg:col-span-9">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <h1 class="type-h1 mt-4">{title}</h1>
    {lead && <p class="type-lead text-ink-muted mt-8 measure-wide">{lead}</p>}
  </div>
</section>
