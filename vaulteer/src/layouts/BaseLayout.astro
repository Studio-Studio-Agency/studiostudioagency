---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

/**
 * Basis-Layout. Enthaelt den fixen Rahmen, die Kopf- und die Fusszeile.
 *
 * Keine Verbindung zu Drittdomains: keine Webfonts, keine Analytik, keine
 * eingebetteten Player oder Karten. Das ist eine Produktanforderung, keine
 * Praeferenz — der Auftraggeber verkauft Datensouveraenitaet.
 */
interface Props {
  title: string;
  description: string;
  /** Ohne Seitensuffix ausgeben (Startseite) */
  bareTitle?: boolean;
  /** Aus der Suche ausschliessen (Entwuerfe, Danke-Seiten) */
  noindex?: boolean;
  /** JSON-LD Objekte, die zusaetzlich zur Organization ausgegeben werden */
  schema?: Record<string, unknown>[];
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  bareTitle = false,
  noindex = false,
  schema = [],
  ogImage = '/og-default.png',
  ogType = 'website',
} = Astro.props;

const fullTitle = bareTitle ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site ?? site.url);
const ogImageUrl = new URL(ogImage, Astro.site ?? site.url);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#17171A" />

    {
      schema.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
      ))
    }

    <!--
      Analytik: bewusst nicht eingebaut. Falls gewuenscht, hier ein
      selbstgehostetes Plausible- oder Matomo-Snippet einsetzen. Kein Google
      Analytics, kein Tag Manager — beides widerspricht dem Produktversprechen.
    -->
  </head>
  <body>
    <a href="#inhalt" class="skip-link">Zum Inhalt springen</a>

    <div class="site-frame" aria-hidden="true"></div>

    <Header />

    <main id="inhalt">
      <slot />
    </main>

    <Footer />
  </body>
</html>
