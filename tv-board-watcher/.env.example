# Kopieren nach .env und ausfüllen. .env wird nicht ins Git eingecheckt.

# eBay Browse API (developer.ebay.com -> Application Keys -> Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Allegro REST API (apps.developer.allegro.pl)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=

# Brave Search API (api.search.brave.com, Free-Plan) – optional
BRAVE_API_KEY=

# ntfy.sh Push: beliebiges, schwer erratbares Topic, z.B. tvboard-7f3k9x2m
NTFY_TOPIC=
NTFY_TOKEN=

# Telegram (optional, Alternative zu ntfy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP für die tägliche E-Mail
SMTP_USER=
SMTP_PASSWORD=
